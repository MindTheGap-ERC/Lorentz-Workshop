	Ballusia_elmensis        ?0????01?000000000?0100000?10000100??0???000001011110?????????
	Helarctos_malayanus      01000010011001010101011000011010011010011100000011011001001101
	Indarctos_arctoides      11111101101001000101111010111101111011000011111011011010110010
	Indarctos_punjabiensis   11111101101001000101111010111101111011000011101011011010?00010
	Indarctos_vireti         11?11101101001000101111000111101111011000001001011011010?1001?
	Kretzoiarctos_beatrix    11????01?01001000001111001?11?011110110000111010111???????????
	Melursus_ursinus         01001010010100000101011110011001110100000101000111111111111101
