END;


BEGIN MRBAYES;
  set autoclose=yes nowarn=yes;

  [ Mk + v + Gamma: only variable characters were scored (all 62 are
    variable), gamma rate variation with 4 categories              ]
  lset coding=variable rates=gamma;

  [ Gamma-Dirichlet branch-length prior: tree length ~ Gamma(1, 0.34),
    i.e. mean tree length ~2.9; relative branch lengths ~ Dirichlet(1) ]
  prset brlenspr = unconstrained: gammadir(1, 0.34, 1, 1);

  [prset symdirihyperpr=fixed(1.0);]

  [ Display rooting only - the analysis itself is unrooted ]
  outgroup Zaragocyon_daamsi;

mcmcp ngen=1000000 samplefreq=500 nruns=2 nchains=4 burninfrac=0.1;
mcmc printfreq=10000 diagnfreq=5000;

  sumt burninf=0.1;
  sump burninf=0.1;
END;
